{
  "kind": "collectionType",
  "collectionName": "presses",
  "info": {
    "singularName": "press",
    "pluralName": "presses",
    "displayName": "Press",
    "description": "Press coverage mentions (images and videos)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "source": {
      "type": "string",
      "required": true
    },
    "externalUrl": {
      "type": "string",
      "required": true,
      "regex": "^https?://.+"
    },
    "publicationDate": {
      "type": "datetime",
      "required": true
    },
    "excerpt": {
      "type": "text"
    },
    "media": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images", "videos"]
    },
    "videoPoster": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    }
  }
}
