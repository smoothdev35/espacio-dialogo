[Unit]
Description=Strapi CMS — Espacio Dialogo
Documentation=https://docs.strapi.io
After=network.target postgresql.service
Requires=postgresql.service
Wants=certbot.service

[Service]
Type=exec
User=strapi
Group=strapi
WorkingDirectory=/opt/strapi/backend

EnvironmentFile=/opt/strapi/backend/.env
ExecStart=/usr/bin/node /opt/strapi/backend/node_modules/.bin/strapi start

Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/strapi/backend/public/uploads

[Install]
WantedBy=multi-user.target
