---
/**
 * FeaturedUpdateCard
 *
 * Props: title, slug, excerpt, readTime, featuredImage, category — from UpdateCardProps
 *        class? (string) — spread onto root element for consumer overrides
 * Slots: none
 * Tokens: --color-surface-text, --color-border, --radius-lg, --font-headline, --font-body,
 *         --spacing-f4, --spacing-f5, --spacing-f6, --text-h4
 * Hardcoded literals: border = color-mix(white 20%, transparent) — var(--color-border) resolves to same in dark mode
 *                     lg:min-h-[480px] — figma card height at desktop breakpoint
 * Context variants: not needed
 * Composed from: Tag (astro)
 *
 * Structure: single <a> wraps the entire card. Title is <h4> (H4, 36px at desktop per Figma).
 * Read-more is a <span> — underline animation triggers on card hover/focus.
 */

import ReadMore from '@/components/ui/astro/ReadMore.astro'
import Tag from '@components/ui/astro/Tag.astro'
import type { UpdateCardProps } from './update.types'
import { buildSrcSet } from '@/lib/media'

interface Props extends UpdateCardProps {
  class?: string
}

const {
  title,
  slug,
  excerpt,
  readTime,
  featuredImage,
  category,
  class: className,
} = Astro.props
---

<a
  href={`/updates/${slug}`}
  class:list={[
    "group flex flex-col lg:flex-row rounded-lg lg:min-h-[480px]",
    "bg-card-bg border border-border text-page-text hover:underline-0!",
    className,
  ]}
>
  <!-- Featured image: 50% width, full card height -->
  {
    featuredImage && (
      <div class="lg:w-1/2 overflow-hidden rounded-t-lg lg:rounded-l-lg lg:rounded-t-none">
        <img
          src={featuredImage.url}
          alt={featuredImage.alternativeText ?? title}
          srcset={buildSrcSet(featuredImage)}
          sizes="(max-width: 1024px) 100vw, 50vw"
          class="h-full w-full object-cover"
          loading="eager"
        />
      </div>
    )
  }

  <!-- Content panel: 50% width, 48px padding, read-more pinned to bottom -->
  <div class="flex flex-col justify-between gap-f8 p-6 lg:p-12 lg:w-1/2">
    <!-- Top group: info row + heading + excerpt -->
    <div class="flex flex-col gap-f4">
      <!-- Info row: category tag + readTime (no date) -->
      <div class="flex items-center gap-f4">
        {
          category && (
            <Tag label={category.name} />
          )
        }
        <span class="text-muted font-semibold">
          {readTime}
        </span>
      </div>

      <!-- Title: h3 for featured card heading (Figma: H4, 36px at desktop) -->
      <h3 class="text-h4">{title}</h3>

      <!-- Excerpt: card body is 16px (section-level body is 18px); opacity from design -->
      <p>
        {excerpt}
      </p>
    </div>

    <!-- Read more (span — animation triggers on card hover/focus) -->
    <ReadMore />
  </div>
</a>

<style>
  /* Focus ring on the card */
  a:focus-visible {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
  }

  /* Prevent global a:hover underline on children */
  a:hover *,
  a:focus-visible * {
    text-decoration-line: none;
  }

</style>
