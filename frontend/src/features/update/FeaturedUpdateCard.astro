---
/**
 * FeaturedUpdateCard
 *
 * Props: title, slug, excerpt, readTime, featuredImage, category — from UpdateCardProps
 *        class? (string) — spread onto root element for consumer overrides
 * Slots: none
 * Tokens: --color-surface-text, --color-border, --radius-lg, --font-headline, --font-body
 * Hardcoded literals: border = color-mix(white 20%, transparent) — var(--color-border) resolves to same in dark mode
 *                     lg:min-h-[480px] — figma card height at desktop breakpoint
 * Context variants: not needed
 * Composed from: Tag (astro)
 *
 * Structure: single <a> wraps the entire card. Title is <h4> (not a link).
 * Read-more is a <span> — underline animation triggers on card hover/focus.
 */

import Tag from '@components/ui/astro/Tag.astro'
import type { UpdateCardProps } from './update.types'

interface Props extends UpdateCardProps {
  class?: string
}

const {
  title,
  slug,
  excerpt,
  readTime,
  featuredImage,
  category,
  class: className,
} = Astro.props
---

<a
  href={`/updates/${slug}`}
  class:list={[
    "group flex flex-col lg:flex-row rounded-lg lg:min-h-[480px]",
    "bg-card-bg border border-border text-page-text hover:underline-0!",
    className,
  ]}
>
  <!-- Featured image: 50% width, full card height -->
  {
    featuredImage && (
      <div class="lg:w-1/2 overflow-hidden rounded-t-lg lg:rounded-l-lg lg:rounded-t-none">
        <img
          src={featuredImage.url}
          alt={featuredImage.alternativeText ?? title}
          class="h-full w-full object-cover"
          loading="eager"
        />
      </div>
    )
  }

  <!-- Content panel: 50% width, 48px padding, read-more pinned to bottom -->
  <div class="flex flex-col justify-between gap-4 p-6 lg:p-12 lg:w-1/2">
    <!-- Top group: info row + heading + excerpt -->
    <div class="flex flex-col gap-4">
      <!-- Info row: category tag + readTime (no date) -->
      <div class="flex items-center gap-2">
        {
          category && (
            <Tag label={category.name} />
          )
        }
        <span class="text-muted">
          {readTime}
        </span>
      </div>

      <!-- Title: h4 for card-level heading (sits under h1/h2 section titles) -->
      <h4>{title}</h4>

      <!-- Excerpt: card body is 16px (section-level body is 18px); opacity from design -->
      <p>
        {excerpt}
      </p>
    </div>

    <!-- Read more (span — animation triggers on card hover/focus) -->
    <span class="readmore inline-flex w-fit items-center gap-2 text-link-text">
      Read more
      <svg
        class="relative top-px h-4 w-4 shrink-0 transition-transform! duration-200! ease-in-out"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m9 18 6-6-6-6" />
      </svg>
    </span>
  </div>
</a>

<style>
  /* Focus ring on the card */
  a:focus-visible {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
  }

  /* Prevent global a:hover underline on children */
  a:hover *,
  a:focus-visible * {
    text-decoration-line: none;
  }

  /* Read-more underline sweep */
  .readmore {
    position: relative;
  }

  .readmore::after {
    content: '';
    position: absolute;
    bottom: -7px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition-duration: 0.3s;
  }

  a:hover .readmore::after,
  a:focus-visible .readmore::after {
    transform: scaleX(1);
  }

  /* Chevron push on card hover/focus */
  a:hover .readmore svg,
  a:focus-visible .readmore svg {
    transform: translateX(4px);
  }
</style>
