---
/**
 * UpdateHeader
 *
 * Renders the top-of-page header for the Update detail page:
 * breadcrumb → category badge → h1 title → author byline → metadata → share section
 * Desktop: 2-col grid (text left, featured image right)
 * Mobile: single column stack
 *
 * Props:
 *   update: UpdateDetailProps — full update data
 *   class?: string — spread onto root <header>
 * Slots: none
 * Tokens: --color-page-text, --color-muted, --color-link-text, --color-link-hover,
 *         --color-border, --color-page, --color-tag, --color-tag-text, --color-tag-border
 * Hardcoded literals:
 *   - gap-2 (breadcrumb gap) — component-specific layout, no token equivalent
 *   - text-sm (metadata font size) — tailwind default
 *   - text-base (byline font size) — tailwind default
 *   - aspect-[3/2] (featured image ratio) — layout choice, no token equivalent — confirm
 *   - "/ " separator — presentation, no token equivalent
 *   - "•" separator — presentation, no token equivalent
 *   - h-6 w-6 (share icon link containers) — component-specific layout, no token equivalent
 * Context variants: not needed — default page background
 * Composed from: Tag (astro), IconLink, IconLinkedIn, IconX, IconFacebook
 */
import Tag from '@components/ui/astro/Tag.astro'
import IconLink from '@components/icons/IconLink.astro'
import IconLinkedIn from '@components/icons/IconLinkedIn.astro'
import IconX from '@components/icons/IconX.astro'
import IconFacebook from '@components/icons/IconFacebook.astro'
import type { UpdateDetailProps } from './update.types'

interface Props {
  update: UpdateDetailProps
  class?: string
}

const { update, class: className } = Astro.props

// Truncate breadcrumb title to first 2 words
const breadcrumbTitle = update.title.split(/\s+/).slice(0, 2).join(' ')
---

<header class:list={[className]}>
  <div class="grid grid-cols-1 lg:grid-cols-[420px_1fr] gap-8 items-start">
    <!-- Left column: text content -->
    <div class="flex flex-col">
      <!-- Breadcrumb -->
      <nav class="mb-5" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2 text-base text-muted">
          <li><a href="/" class="text-base">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/#updates" class="text-base">Updates</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="font-medium text-page-text text-base" title={update.title}>{breadcrumbTitle}</li>
        </ol>
      </nav>

      <!-- Category badge — styled same as UpdateCard pills -->
      {
        update.category && (
          <div class="mb-8">
            <Tag label={update.category.name} />
          </div>
        )
      }

      <!-- Title — text-h2 overrides global h1 font-size (design: 52px desktop / 36px mobile) -->
      {/* override: global h1 font-size — design requires smaller heading for featured media balance */}
      <h1 class="text-h2 mb-6">{update.title}</h1>

      <!-- Author byline — only when author exists -->
      {
        update.author && (
          <p class="text-base mb-1">
            <span class="text-muted">By </span>
            <span class="font-semibold text-page-text">{update.author.name}</span>
          </p>
        )
      }

      <!-- Metadata: read time • published date -->
      <p class="text-sm text-muted">
        <time datetime={update.publishedAt}>{update.readTime}</time>
        <span aria-hidden="true"> • </span>
        <span>Published on <time datetime={update.publishedAt}>{update.publishedAt}</time></span>
      </p>

      <!-- Share section — buttons trigger actions (copy link, share), not navigation -->
      <div class="mt-6">
        <p class="text-base font-semibold mb-3">Share this dispatch</p>
        <div class="flex items-center gap-4">
          <button type="button" class="flex h-6 w-6 cursor-pointer items-center justify-center text-page-text transition-colors hover:text-link-hover focus-visible:text-link-hover" aria-label="Copy link">
            <IconLink class="w-5 h-5" />
          </button>
          <button type="button" class="flex h-6 w-6 cursor-pointer items-center justify-center text-page-text transition-colors hover:text-link-hover focus-visible:text-link-hover" aria-label="Share on LinkedIn">
            <IconLinkedIn class="w-5 h-5" />
          </button>
          <button type="button" class="flex h-6 w-6 cursor-pointer items-center justify-center text-page-text transition-colors hover:text-link-hover focus-visible:text-link-hover" aria-label="Share on X">
            <IconX class="w-5 h-5" />
          </button>
          <button type="button" class="flex h-6 w-6 cursor-pointer items-center justify-center text-page-text transition-colors hover:text-link-hover focus-visible:text-link-hover" aria-label="Share on Facebook">
            <IconFacebook class="w-5 h-5" />
          </button>
        </div>
      </div>
    </div>

    <!-- Right column: featured image -->
    {
      update.featuredImage && (
        <div class="flex-1 min-w-0 mt-f9 xl:mt-0">
          <img
            src={update.featuredImage.url}
            alt={update.featuredImage.alternativeText ?? ''}
            class="w-full aspect-video xl:aspect-3/2 2xl:aspect-video rounded-lg object-cover"
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }
  </div>
</header>
