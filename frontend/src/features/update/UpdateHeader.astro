---
/**
 * UpdateHeader
 *
 * Renders the top-of-page header for the Update detail page:
 * breadcrumb → category badge → h1 title → author (avatar+name) • read time • date → share section
 * Desktop: flex row — text column fixed at 448px, image fills remaining space with 16:9.
 * Mobile: single column stack.
 *
 * Semantic: <header> inside <article>, <h1> for article-level heading.
 * Gaps driven by fluid tokens (--spacing-component-gap, --spacing-f7).
 * Image: always aspect-video (16:9), no breakpoint override.
 *
 * Props:
 *   update: UpdateDetailProps — full update data
 *   class?: string — spread onto root <header>
 * Slots: none
 * Tokens: --color-page-text, --color-muted, --color-link-text, --color-link-hover,
 *         --color-border, --color-page, --color-tag, --color-tag-text, --color-tag-border,
 *         --spacing-component-gap, --spacing-f7
 * Hardcoded literals:
 *   - gap-2 (breadcrumb gap) — component-specific layout, no token equivalent
 *   - gap-x-2 gap-y-1 (author metadata gap) — component-specific layout, no token equivalent
 *   - text-sm (read time / date) — fixed 14px per Figma desktop+mobile
 *   - text-base (author/breadcrumb/share) — fixed 16px per Figma desktop+mobile
 *   - "/ " separator — presentation, no token equivalent
 *   - "•" separator — presentation, no token equivalent
 *   - h-6 w-6 (avatar + share icon containers) — component-specific layout, no token equivalent
 *   - gap-16 (64px — text↔image gap) — component-specific layout, no token equivalent
 *   - w-[448px] (text column width) — component-specific layout, no token equivalent
 * Context variants: not needed — default page background
 * Composed from: Tag (astro), IconLink, IconLinkedIn, IconX, IconFacebook
 */
import Tag from '@components/ui/astro/Tag.astro'
import IconLink from '@components/icons/IconLink.astro'
import IconLinkedIn from '@components/icons/IconLinkedIn.astro'
import IconX from '@components/icons/IconX.astro'
import IconFacebook from '@components/icons/IconFacebook.astro'
import type { UpdateDetailProps } from './update.types'
import { buildSrcSet } from '@/lib/media'
import { UPDATE_HEADER } from '@/lib/content'

interface Props {
  update: UpdateDetailProps
  class?: string
}

const { update, class: className } = Astro.props

// Truncate breadcrumb title to first 2 words
const breadcrumbTitle = update.title.split(/\s+/).slice(0, 2).join(' ')
---

<header class:list={[className]}>
  <div class="flex flex-col xl:flex-row gap-0 2xl:gap-16 items-start">
    <!-- Left column: text content — fixed width -->
    <div class="flex flex-col xl:w-[448px] xl:shrink-0">
      <!-- Breadcrumb + category badge in same row -->
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2 text-base">
          <li><a href="/">{UPDATE_HEADER.home}</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/#updates">{UPDATE_HEADER.updates}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="font-medium text-page-text text-base" title={update.title}>{breadcrumbTitle}</li>
        </ol>
      </nav>

      <!-- Title — h1 semantics, text-h2 keeps visual size -->
      <h1 class="text-h2 mt-f8">{update.title}</h1>

      <!-- Author avatar + name (row 1), read time + date (row 2) -->
      <div class="flex flex-col gap-y-1 mt-f9">
        <div class="flex items-center gap-2">
          {
            update.author?.avatar && (
              <img
                src={update.author.avatar.url}
                alt={update.author.avatar.alternativeText ?? `${update.author.name}'s avatar`}
                class="h-6 w-6 shrink-0 rounded-full object-cover"
                loading="lazy"
              />
            )
          }
          {
            update.author && (
              <span class="text-base font-semibold">{update.author.name}</span>
            )
          }
        </div>
        <div class="flex items-center gap-x-2">
          <span class="text-sm font-semibold text-muted">{update.readTime}</span>
          <span aria-hidden="true" class="text-sm text-muted">•</span>
          <time datetime={update.dateIso}>{update.publishedAt}</time>
        </div>
      </div>

      <!-- Share section -->
      <div class="mt-f8">
        <p class="text-base font-medium">{UPDATE_HEADER.shareDispatch}</p>
        <div class="flex items-center gap-4 mt-f4">
          <button type="button" class="flex h-6 w-6 cursor-pointer items-center justify-center transition-colors hover:text-link-hover focus-visible:text-link-hover" aria-label={UPDATE_HEADER.copyLink}>
            <IconLink class="w-5 h-5" />
          </button>
          <button type="button" class="flex h-6 w-6 cursor-pointer items-center justify-center transition-colors hover:text-link-hover focus-visible:text-link-hover" aria-label={UPDATE_HEADER.shareLinkedIn}>
            <IconLinkedIn class="w-5 h-5" />
          </button>
          <button type="button" class="flex h-6 w-6 cursor-pointer items-center justify-center transition-colors hover:text-link-hover focus-visible:text-link-hover" aria-label={UPDATE_HEADER.shareX}>
            <IconX class="w-5 h-5" />
          </button>
          <button type="button" class="flex h-6 w-6 cursor-pointer items-center justify-center transition-colors hover:text-link-hover focus-visible:text-link-hover" aria-label={UPDATE_HEADER.shareFacebook}>
            <IconFacebook class="w-5 h-5" />
          </button>
        </div>
      </div>
    </div>

    <!-- Right column: featured image -->
    {
      update.featuredImage && (
        <div class="flex-1 min-w-0 mt-f9 xl:mt-0">
          <img
            src={update.featuredImage.url}
            alt={update.featuredImage.alternativeText ?? ''}
            srcset={buildSrcSet(update.featuredImage)}
            sizes="(max-width: 1280px) 100vw, 60vw"
            class="w-full aspect-video xl:aspect-3/2 2xl:aspect-video rounded-lg object-cover"
            loading="eager"
          />
        </div>
      )
    }
  </div>
</header>
