---
/**
 * UpdateCard
 *
 * Props: title, slug, excerpt, readTime, featuredImage, category — from UpdateCardProps
 *        class? (string) — spread onto root element for consumer overrides
 * Slots: none
 * Tokens: --color-surface-text, --color-border, --radius-lg, --font-headline, --font-body,
 *         --spacing-f4, --spacing-f5, --spacing-f6, --text-h5
 * Hardcoded literals: none
 *                     image aspect-video (16:9) — from Figma grid card ratio
 * Context variants: not needed
 * Composed from: Tag (astro)
 *
 * Structure: single <a> wraps the entire card. Title is <h5> (unified card heading token).
 * Read-more is a <span> — underline animation triggers on card hover/focus.
 */

import ReadMore from '@/components/ui/astro/ReadMore.astro'
import Tag from '@components/ui/astro/Tag.astro'
import type { UpdateCardProps } from './update.types'

interface Props extends UpdateCardProps {
  class?: string
}

const {
  title,
  slug,
  excerpt,
  readTime,
  featuredImage,
  category,
  class: className,
} = Astro.props
---

<a
  href={`/updates/${slug}`}
  class:list={[
    'update-card group flex flex-col rounded-lg',
    'bg-card-bg border-border text-page-text hover:underline-0! border',
    className,
  ]}
>
  <!-- Featured image: 16:9 aspect ratio (matches Figma grid card) -->
  {
    featuredImage && (
      <div class="overflow-hidden rounded-t-lg">
        <img
          src={featuredImage.url}
          alt={featuredImage.alternativeText ?? title}
          class="aspect-video h-full w-full object-cover"
          loading="lazy"
        />
      </div>
    )
  }

  <!-- Content: 24px padding, read-more pinned to bottom -->
  <div class="gap-f8 flex flex-col justify-between p-6">
    <!-- Top group: info row + heading + excerpt -->
    <div class="gap-f4 flex flex-col">
      <!-- Info row: category tag + readTime (no date) -->
      <div class="gap-f4 flex items-center">
        {category && <Tag label={category.name} />}
        <span class="text-muted font-semibold">
          {readTime}
        </span>
      </div>

      <!-- Title: h4 for card-level heading (unified token across all cards) -->
      <h4 class="text-h5">{title}</h4>

      <!-- Excerpt: card body 16px (section-level body is 18px); clamp from design -->
      <p class="line-clamp-3">
        {excerpt}
      </p>
    </div>

    <!-- Read more (span — animation triggers on card hover/focus) -->
    <ReadMore />
  </div>
</a>

<style is:global>
  /* Focus ring on the card */
  .update-card:focus-visible {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
  }

  /* Prevent global a:hover underline on children */
  .update-card:hover *,
  .update-card:focus-visible * {
    text-decoration-line: none;
  }
</style>
