---
/**
 * UpdatePagination
 *
 * Client-side pagination for the updates grid. 4 items per page.
 * All state derived from DOM. No props required.
 * Listens for 'filter-change' custom event on [data-update-grid].
 *
 * Props: class? (string) — spread onto root <nav> for consumer overrides
 * Slots: none
 * Tokens: --color-page-text, --radius-md
 * Hardcoded literals: PAGE_SIZE = 4 (from plan — 2-col grid × 2 rows)
 * Context variants: not needed
 * Composed from: Button (nav variant)
 */

import Button from '@/components/ui/astro/Button.astro'
import { UPDATE_PAGINATION } from '@/lib/content'

interface Props {
  class?: string
}

const { class: className } = Astro.props

const chevronLeft =
  '<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>'

const chevronRight =
  '<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>'
---

<nav
  aria-label={UPDATE_PAGINATION.ariaLabel}
  data-update-pagination
  class:list={[
    "flex items-center justify-center gap-4",
    className,
  ]}
>
  <Button
    variant="nav"
    size="md"
    iconPosition="only"
    label={UPDATE_PAGINATION.prevPage}
    icon={chevronLeft}
    data-page-prev
  />

  <div data-page-buttons class="flex items-center gap-2"></div>

  <Button
    variant="nav"
    size="md"
    iconPosition="only"
    label={UPDATE_PAGINATION.nextPage}
    icon={chevronRight}
    data-page-next
  />
</nav>

<style is:global>
  /* Page buttons — global selectors for dynamically created DOM elements */
  [data-page] {
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    color: var(--color-page-text);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  @media (hover: hover) {
    [data-page]:hover {
      background-color: color-mix(in srgb, var(--color-page-text) 10%, transparent);
    }
  }

  [data-page][aria-current='true'] {
    background-color: color-mix(in srgb, var(--color-page-text) 20%, transparent);
    font-weight: 700;
  }

  /* Pagination visibility — separate from filter's `hidden` attribute */
  [data-page-hidden="true"] {
    display: none;
  }
</style>

<script>
  (function () {
    var PAGE_SIZE = 4
    var nav = document.querySelector('[data-update-pagination]')
    var grid = document.querySelector('[data-update-grid]')
    var empty = document.querySelector('[data-update-empty]')
    var pageContainer = nav.querySelector('[data-page-buttons]')
    var prevBtn = nav.querySelector('[data-page-prev]')
    var nextBtn = nav.querySelector('[data-page-next]')

    if (!nav || !grid) return

    function getVisibleItems() {
      var items = Array.from(grid.querySelectorAll(':scope > li'))
      return items.filter(function (el) { return !el.hidden })
    }

    function showPage(page) {
      var items = getVisibleItems()

      for (var i = 0; i < items.length; i++) {
        var idx = parseInt(items[i].getAttribute('data-page-index') || '0')
        items[i].dataset.pageHidden = (idx !== page).toString()
      }

      var buttons = pageContainer.querySelectorAll('[data-page]')
      for (var j = 0; j < buttons.length; j++) {
        var btn = buttons[j]
        var isActive = parseInt(btn.getAttribute('data-page')) === page
        if (isActive) {
          btn.setAttribute('aria-current', 'true')
        } else {
          btn.removeAttribute('aria-current')
        }
      }

      prevBtn.disabled = page === 0
      nextBtn.disabled = page >= buttons.length - 1
    }

    function getCurrentPage() {
      var active = pageContainer.querySelector('[aria-current="true"]')
      return active ? parseInt(active.getAttribute('data-page')) : 0
    }

    function render() {
      var items = getVisibleItems()
      var totalPages = Math.ceil(items.length / PAGE_SIZE)

      // Empty state — visible only when no grid items match
      if (empty) {
        empty.hidden = items.length > 0
      }

      // Always visible — show single page with disabled arrows
      if (totalPages <= 1) {
        nav.hidden = false
        pageContainer.innerHTML = '<button type="button" data-page="0" aria-current="true">1</button>'
        prevBtn.disabled = true
        nextBtn.disabled = true
        for (var i = 0; i < items.length; i++) {
          delete items[i].dataset.pageHidden
          items[i].setAttribute('data-page-index', '0')
        }
        return
      }

      nav.hidden = false

      // Assign page indices
      for (var j = 0; j < items.length; j++) {
        items[j].setAttribute('data-page-index', Math.floor(j / PAGE_SIZE))
      }

      // Build page buttons
      var html = ''
      for (var p = 0; p < totalPages; p++) {
        html += '<button type="button" data-page="' + p + '">' + (p + 1) + '</button>'
      }
      pageContainer.innerHTML = html

      // Show first page
      showPage(0)
    }

    // Delegated click on page buttons — no-op if clicking the active page
    pageContainer.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-page]')
      if (!btn) return
      var page = parseInt(btn.getAttribute('data-page'))
      if (page === getCurrentPage()) return
      showPage(page)
    })

    prevBtn.addEventListener('click', function () {
      var cur = getCurrentPage()
      if (cur > 0) showPage(cur - 1)
    })

    nextBtn.addEventListener('click', function () {
      var cur = getCurrentPage()
      var total = pageContainer.querySelectorAll('[data-page]').length
      if (cur < total - 1) showPage(cur + 1)
    })

    // Recalculate on filter change
    grid.addEventListener('filter-change', function () {
      render()
    })

    // Initial render
    render()
  })()
</script>
