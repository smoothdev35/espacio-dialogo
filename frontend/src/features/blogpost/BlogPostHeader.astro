---
/**
 * BlogPostHeader
 *
 * Renders the top-of-page header for the BlogPost detail page:
 * back link → tag + date → h1 title → featured image → author/read-time + share
 * Desktop: stacked layout with full-width image between title and bottom row
 * Mobile: reordered — image drops below all text content
 *
 * Props:
 *   post: BlogPostDetailProps — mapped blog post data (consumed by header only)
 *   class?: string — spread onto root <section>
 * Slots: none
 * Tokens: --color-page-text, --color-muted, --color-link-text, --color-link-hover,
 *         --color-page, --spacing-section-pad-lg, --spacing-component-gap
 * Hardcoded literals:
 *   - "←" chevron — decorative unicode, no token equivalent
 *   - "•" separator — presentation, no token equivalent
 *   - gap-2 (metadata row gap) — component-specific layout, no token equivalent
 *   - rounded-lg (featured image) — matches Figma radius (8px), no token equivalent
 *   - h-6 w-6 (share icon button containers) — component-specific layout, no token equivalent
 * Context variants: not needed — uses default page background
 * Composed from: Tag, Container, IconLink, IconLinkedIn, IconX, IconFacebook
 */
import Container from '@/layouts/Container.astro'
import Tag from '@components/ui/astro/Tag.astro'
import IconLink from '@components/icons/IconLink.astro'
import IconLinkedIn from '@components/icons/IconLinkedIn.astro'
import IconX from '@components/icons/IconX.astro'
import IconFacebook from '@components/icons/IconFacebook.astro'
import type { BlogPostDetailProps } from './blogpost.types'

interface Props {
  post: BlogPostDetailProps
  class?: string
}

const { post, class: className } = Astro.props

/** Share URL — uses canonical URL at runtime via JS */
const shareUrl = import.meta.env.SITE_URL
  ? `${import.meta.env.SITE_URL}/blog/${post.slug}`
  : typeof window !== 'undefined'
    ? window.location.href
    : `/blog/${post.slug}`
---

{/* Containment: Contained — header content respects max-width column */}
<section class:list={["bg-page py-(--spacing-section-pad-lg)", className]}>
  <Container>
    <div class="flex flex-col gap-(--spacing-component-gap) md:gap-6">
      <!-- Back link — order 1 -->
      <a
        href="/blog"
        class="order-1 inline-flex items-center gap-1 text-base font-medium text-muted hover:text-page-text transition-colors"
      >
        <span aria-hidden="true" class="text-lg leading-none">←</span>
        All posts
      </a>

      <!-- Metadata: tag + date — order 2 -->
      <div class="order-2 inline-flex flex-wrap items-center gap-2">
        {
          post.tags.length > 0 && (
            <Tag label={post.tags[0].name} />
          )
        }
        <time datetime={post.publishedAt} class="text-sm font-semibold text-muted">
          {post.publishedAt}
        </time>
      </div>

      <!-- Title — order 3 -->
      <h1 class="order-3 max-w-(--container-large)">{post.title}</h1>

      <!-- Author byline + read time — order 4 desktop, order 6 mobile (below share) -->
      <div class="order-4 md:order-4">
        {
          post.author && (
            <span class="text-base text-page-text">{post.author.name}</span>
          )
        }
        {
          post.author && (
            <span aria-hidden="true" class="text-base text-muted mx-1">•</span>
          )
        }
        <span class="text-base text-muted">{post.readTime}</span>
      </div>

      <!-- Share buttons — order 5 -->
      <div class="order-5 md:order-5 flex items-center gap-4">
        <button
          type="button"
          class="flex h-6 w-6 cursor-pointer items-center justify-center text-page-text transition-colors hover:text-link-hover focus-visible:text-link-hover"
          aria-label="Copy link"
          data-copy-url={shareUrl}
        >
          <IconLink class="w-5 h-5" />
        </button>
        <a
          href={`https://linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-6 w-6 items-center justify-center text-page-text transition-colors hover:text-link-hover focus-visible:text-link-hover"
          aria-label="Share on LinkedIn"
        >
          <IconLinkedIn class="w-5 h-5" />
        </a>
        <a
          href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-6 w-6 items-center justify-center text-page-text transition-colors hover:text-link-hover focus-visible:text-link-hover"
          aria-label="Share on X"
        >
          <IconX class="w-5 h-5" />
        </a>
        <a
          href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-6 w-6 items-center justify-center text-page-text transition-colors hover:text-link-hover focus-visible:text-link-hover"
          aria-label="Share on Facebook"
        >
          <IconFacebook class="w-5 h-5" />
        </a>
      </div>

      <!-- Featured image — order 6 on mobile, order 5 on desktop (between title + bottom row) -->
      {
        post.featuredImage && (
          <div class="order-6 md:order-[5] -mt-2 md:mt-0">
            <img
              src={post.featuredImage.url}
              alt={post.featuredImage.alternativeText ?? ''}
              class="w-full aspect-[3/2] rounded-lg object-cover"
              loading="eager"
              decoding="async"
            />
          </div>
        )
      }
    </div>
  </Container>
</section>
