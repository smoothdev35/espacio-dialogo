---
/**
 * BlogPostHeader
 *
 * Renders the top-of-page header for the BlogPost detail page:
 * back link → tags (all) + date → h1 title → featured image (16:9) →
 * bottom bar: author/read-time (left) + share buttons (right)
 * Desktop: single row for bottom bar (justify-between)
 * Mobile: bottom bar stacks (share below author info)
 *
 * Props:
 *   post: BlogPostDetailProps — mapped blog post data (consumed by header only)
 * Slots: none
 * Tokens: --color-page-text, --color-muted, --color-link-text, --color-link-hover,
 *         --spacing-f11, --spacing-f8
 * Hardcoded literals:
 *   - "←" chevron — decorative unicode, no token equivalent
 *   - "•" separator — presentation, no token equivalent
 *   - gap-4 (share buttons gap) — component-specific layout, no token equivalent
 *   - gap-2 (metadata row gap) — component-specific layout, no token equivalent
 *   - rounded-lg (featured image) — matches Figma radius (8px), no token equivalent
 *   - h-6 w-6 (share icon button containers) — component-specific layout, no token equivalent
 * Context variants: not needed — uses default page background
 * Composed from: Tag, IconLink, IconLinkedIn, IconX, IconFacebook
 */
import Tag from '@components/ui/astro/Tag.astro'
import IconLink from '@components/icons/IconLink.astro'
import IconLinkedIn from '@components/icons/IconLinkedIn.astro'
import IconX from '@components/icons/IconX.astro'
import IconFacebook from '@components/icons/IconFacebook.astro'
import type { BlogPostDetailProps } from './blogpost.types'
import { buildSrcSet } from '@/lib/media'
import { BLOG_HEADER } from '@/lib/content'

interface Props {
  post: BlogPostDetailProps
}

const { post } = Astro.props

/** Share URL — uses canonical URL at runtime via JS */
const shareUrl = import.meta.env.SITE_URL
  ? `${import.meta.env.SITE_URL}/blog/${post.slug}`
  : typeof window !== 'undefined'
    ? window.location.href
    : `/blog/${post.slug}`
---

<div class="flex flex-col">
  <!-- Back link -->
  <a href="/blog" class="inline-flex items-center gap-1">
    <span aria-hidden="true" class="text-lg leading-none">←</span>
    {BLOG_HEADER.backToBlog}
  </a>

  <!-- Metadata: tags + date -->
  <div class="mt-f8 gap-f4 inline-flex flex-wrap items-center gap-y-2">
    {post.tags.length > 0 && post.tags.map((tag) => <Tag label={tag.name} />)}
    <time datetime={post.dateIso} class="ml-1">
      {post.publishedAt}
    </time>
  </div>

  <!-- Title -->
  <h1 class="text-h2 mt-f8 max-w-(--container-large)">{post.title}</h1>

  <!-- Featured image, between title and bottom bar -->
  {
    post.featuredImage && (
      <div class="mt-f9">
        <img
          src={post.featuredImage.url}
          alt={post.featuredImage.alternativeText ?? ''}
          srcset={buildSrcSet(post.featuredImage)}
          sizes="(max-width: 1536px) 100vw, 1536px"
          class="aspect-video w-full rounded-lg object-cover"
          loading="eager"
        />
      </div>
    )
  }

  <!-- Bottom bar: author+readtime (left) + share buttons (right) -->
  <div
    class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
  >
    <!-- Author byline + read time -->
    <div class="flex items-center gap-2">
      {
        post.author?.avatar && (
          <img
            src={post.author.avatar.url}
            alt={
              post.author.avatar.alternativeText ??
              `${post.author.name}'s avatar`
            }
            class="h-6 w-6 shrink-0 rounded-full object-cover"
            loading="lazy"
          />
        )
      }
      {
        post.author && (
          <span class="text-base font-semibold">{post.author.name}</span>
        )
      }
      {
        post.author && (
          <span aria-hidden="true" class="text-muted text-base">
            •
          </span>
        )
      }
      <span class="text-muted text-base font-semibold">{post.readTime}</span>
    </div>

    <!-- Share buttons -->
    <div class="flex items-center gap-4">
      <button
        type="button"
        class="hover:text-link-hover focus-visible:text-link-hover flex h-6 w-6 cursor-pointer items-center justify-center"
        aria-label={BLOG_HEADER.copyLink}
        data-copy-url={shareUrl}
      >
        <IconLink class="h-5 w-5" />
      </button>
      <a
        href={`https://linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-page-text hover:text-link-hover focus-visible:text-link-hover flex h-6 w-6 items-center justify-center"
        aria-label={BLOG_HEADER.shareLinkedIn}
      >
        <IconLinkedIn class="h-5 w-5" />
      </a>
      <a
        href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-page-text hover:text-link-hover focus-visible:text-link-hover flex h-6 w-6 items-center justify-center"
        aria-label={BLOG_HEADER.shareX}
      >
        <IconX class="h-5 w-5" />
      </a>
      <a
        href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-page-text hover:text-link-hover focus-visible:text-link-hover flex h-6 w-6 items-center justify-center"
        aria-label={BLOG_HEADER.shareFacebook}
      >
        <IconFacebook class="h-5 w-5" />
      </a>
    </div>
  </div>
</div>
