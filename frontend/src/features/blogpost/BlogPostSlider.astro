---
/**
 * BlogPostSlider
 *
 * Renders a horizontal scrolling slider of blog post cards.
 * Matches Figma "Blog / 65 /" design.
 *
 * Accepts optional `posts` prop. When omitted, self-fetches from Strapi.
 *
 * Props:
 *   posts? — pre-fetched posts (skip self-fetch)
 *   heading? — section heading (default: "Short heading goes here")
 *   description? — optional subtitle below heading
 *   showViewAll? — show "View all" button (default: true)
 *   class? — spread onto root <section>
 * Slots: none
 * Tokens: --color-page (section background), --color-page-text, --color-muted,
 *         --spacing-f4, --spacing-f5, --spacing-f6, --spacing-row-gap,
 *         --font-headline, --font-body,
 *         --text-h5, --text-tagline, --text-body,
 *         --color-nav-bg (arrow bg), --color-nav-btn-fg (arrow icons + active dot fill),
 *         --color-dot-inactive
 * Hardcoded literals:
 *   - scroll-snap / overflow-x — layout-specific, no token equivalent
 *   - Card width 394px — from Figma spec — confirm
 *   - Arrow buttons 48×48, gap-4 dots — layout-specific
 *   - Arrow bg uses --color-nav-bg token (semantic, theme-aware)
 *   - Arrow SVG paths — standard chevron icons
 *   - Client JS: dots navigate cards, arrows prev/next, active dot on scroll — no framework for interactivity
 * Context variants: not needed — section uses explicit bg-page, cards have no background
 * Composed from: Container, SectionHeader, BlogPostCard
 */

import Container from '@/layouts/Container.astro'
import SectionHeader from '@/components/ui/astro/SectionHeader.astro'
import BlogPostCard from './BlogPostCard.astro'
import { fetchBlogPosts } from './blogpost.api'
import type { BlogPostCardProps } from './blogpost.types'
import Button from '@/components/ui/astro/Button.astro'
import { BLOG_SLIDER } from '@/lib/content'

interface Props {
  posts?: BlogPostCardProps[]
  tagline?: string
  heading?: string
  description?: string
  showViewAll?: boolean
  class?: string
}

const {
  posts: providedPosts,
  tagline = BLOG_SLIDER.tagline,
  heading = BLOG_SLIDER.heading,
  description,
  showViewAll = true,
  class: className,
} = Astro.props

const posts: BlogPostCardProps[] =
  providedPosts ??
  (await fetchBlogPosts().catch((err) => {
    console.error('Failed to fetch blog posts:', err)
    return []
  }))
---

<section class:list={[className]}>
  <Container>
    <div class="gap-f9 flex flex-col">
      <!-- ═══ Title row ═══ -->
      <SectionHeader
        tagline={tagline}
        heading={heading}
        description={description}
      >
        {
          showViewAll && (
            <Button
              slot="action"
              variant="secondary"
              label={BLOG_SLIDER.viewAll}
              href="/blog"
            />
          )
        }
      </SectionHeader>

      <!-- ═══ Slider row ═══ -->
      <div class="gap-f9 flex flex-col">
        {
          posts.length > 0 ? (
            <>
              {/* Cards */}
              <div
                id="blog-slider-track"
                class="gap-f8 scrollbar-hide -mx-2 -mb-4 -mt-2 flex snap-x snap-mandatory overflow-x-auto px-2 pb-4 pt-2"
                style="scrollbar-width: none; -ms-overflow-style: none; scroll-padding-left: 8px;"
              >
                {posts.map((post) => (
                  <BlogPostCard
                    slug={post.slug}
                    title={post.title}
                    excerpt={post.excerpt}
                    featuredImage={post.featuredImage}
                    class="blog-card w-[85vw] shrink-0 snap-start sm:w-[380px] lg:w-[394px]"
                  >
                    {/* Author row */}
                    {post.author ? (
                      <div slot="footer" class="flex items-center gap-4">
                        {post.author.avatar ? (
                          <img
                            src={post.author.avatar}
                            alt={post.author.name}
                            class="h-12 w-12 rounded-full object-cover"
                            loading="lazy"
                          />
                        ) : (
                          <div
                            class="bg-muted h-12 w-12 rounded-full"
                            aria-hidden="true"
                          />
                        )}

                        <div class="flex flex-col gap-y-1">
                          <span class="font-semibold">{post.author.name}</span>
                          <div class="text-muted flex items-center gap-2 text-sm font-semibold">
                            <time datetime={post.dateIso}>
                              {post.publishedAt}
                            </time>
                            <span aria-hidden="true">•</span>
                            <span>{post.readTime}</span>
                          </div>
                        </div>
                      </div>
                    ) : null}
                  </BlogPostCard>
                ))}
              </div>

              {/* Controls: dots + arrows */}
              <div class="flex flex-row items-center justify-between gap-4">
                {/* Dot breadcrumbs — 6 dots, Figma spec */}
                <div class="flex gap-4">
                  {posts.map((_, i) => (
                    <button
                      type="button"
                      data-index={i}
                      class="blog-slider-dot bg-dot-inactive hover:bg-nav-btn-fg focus-visible:bg-nav-btn-fg h-2 w-2 rounded-full"
                      aria-label={BLOG_SLIDER.goToPost(i + 1)}
                    />
                  ))}
                </div>

                {/* Arrow buttons — nav variant (48×48, token-driven bg/icon/hover) */}
                <div class="flex gap-2">
                  <Button
                    id="blog-slider-prev"
                    variant="nav"
                    size="md"
                    iconPosition="only"
                    label={BLOG_SLIDER.prevPosts}
                    icon='<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>'
                  />
                  <Button
                    id="blog-slider-next"
                    variant="nav"
                    size="md"
                    iconPosition="only"
                    label={BLOG_SLIDER.nextPosts}
                    icon='<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>'
                  />
                </div>
              </div>
            </>
          ) : (
            <p class="text-h6 py-16 text-center">{BLOG_SLIDER.noPosts}</p>
          )
        }
      </div>
    </div>
  </Container>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('blog-slider-track')
    if (!track || !track.children.length) return

    const cards = Array.from(track.querySelectorAll('.blog-card'))
    const dots = Array.from(document.querySelectorAll('.blog-slider-dot'))
    const prevBtn = document.getElementById('blog-slider-prev')
    const nextBtn = document.getElementById('blog-slider-next')

    const gap = parseInt(getComputedStyle(track).columnGap || '24', 10)

    function getCardWidth() {
      return cards[0]?.offsetWidth ?? 0
    }

    function getCurrentIndex() {
      const w = getCardWidth() + gap
      if (w <= 0) return 0
      return Math.round(track.scrollLeft / w)
    }

    function scrollToIndex(index) {
      const w = getCardWidth() + gap
      if (w <= 0) return
      track.scrollTo({ left: index * w, behavior: 'smooth' })
    }

    function updateUI() {
      const i = getCurrentIndex()
      dots.forEach((dot, idx) => {
        const isActive = idx === i
        dot.disabled = isActive
      })
      if (prevBtn) prevBtn.disabled = i <= 0
      if (nextBtn)
        nextBtn.disabled =
          track.scrollLeft + track.clientWidth >= track.scrollWidth - 1
    }

    // Dot clicks
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = parseInt(dot.getAttribute('data-index') ?? '0', 10)
        scrollToIndex(idx)
      })
    })

    // Arrow clicks
    prevBtn?.addEventListener('click', () =>
      scrollToIndex(getCurrentIndex() - 1),
    )
    nextBtn?.addEventListener('click', () =>
      scrollToIndex(getCurrentIndex() + 1),
    )

    // Update active dot on scroll (throttled via requestAnimationFrame)
    let ticking = false
    track.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateUI()
          ticking = false
        })
        ticking = true
      }
    })

    // Initial state
    updateUI()

    // Recalculate on resize
    let resizeTimer
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer)
      resizeTimer = setTimeout(updateUI, 100)
    })
  })
</script>

<style is:global>
  .blog-slider-dot:disabled {
    cursor: default;
    background-color: var(--color-nav-btn-fg);
  }
</style>

<style is:global>
  .blog-card img {
    transition: transform 400ms cubic-bezier(0.25, 0.1, 0.25, 1);
    transform: scale(1);
  }

  @media (hover: hover) {
    .blog-card:hover img {
      transform: scale(1.08);
    }
  }
  .blog-card:focus-visible img {
    transform: scale(1.08);
  }
</style>
