---
/**
 * HomeLayout
 *
 * Thin shell — all child sections self-fetch their data.
 *
 * Props: class? (string) — spread onto root <div> for consumer overrides
 * Slots: none
 * Tokens: none directly — delegates to child components
 * Hardcoded literals: none
 * Context variants: not needed
 * Composed from: Hero, Updates, BlogPostSlider, CTA
 */

import Hero from './Hero.astro'
import Updates from './Updates.astro'
import BlogPostSlider from '@/features/blogpost/BlogPostSlider.astro'
import CTA from './CTA.astro'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<div class:list={[className]}>
  <!-- Hero self-fetches its data -->
  <Hero />

  <!-- Updates self-fetches its data -->
  <Updates />

  <!-- CTA self-contained section with Donate / Contact buttons -->
  <CTA />

  <!-- Blog posts slider self-fetches its data -->
  <BlogPostSlider />

  <!-- Placeholder: Footer will go here -->
</div>
