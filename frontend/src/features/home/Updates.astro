---
/**
 * Updates
 *
 * Self-fetches update data. No props required.
 * Layout (Option B): heading → description → FilterPills → FeaturedUpdateCard → UpdatePagination → UpdateGrid
 * Featured always visible. Filter only controls grid. Pagination resets on filter change.
 *
 * Props: class? (string) — spread onto root <section> for consumer overrides
 * Slots: none
 * Tokens: --spacing-section-pad, --spacing-component-gap, --spacing-row-gap, --font-headline, --font-body
 * Hardcoded literals: none — page bg shows through via body
 * Context variants: not needed
 * Composed from: Container, FilterPills, FeaturedUpdateCard, UpdateGrid, UpdatePagination
 */

import Container from '@/layouts/Container.astro'
import FeaturedUpdateCard from '@/features/update/FeaturedUpdateCard.astro'
import UpdateGrid from '@/features/update/UpdateGrid.astro'
import FilterPills from '@/components/ui/astro/FilterPills.astro'
import UpdatePagination from '@/features/update/UpdatePagination.astro'
import { fetchUpdates } from '@/features/update/update.api'

interface Props {
  class?: string
}

const { class: className } = Astro.props

const updateData = await fetchUpdates().catch((err) => {
  console.error('Failed to fetch updates:', err)
  return { featured: null, grid: [], categories: [] }
})

const featured = updateData.featured
const gridArticles = updateData.grid
const categories = updateData.categories
---

{/* Section bg is transparent — page background shows through via body */}
<section id="updates" class:list={[className]}>
  <Container>
    <div class="flex flex-col gap-component-gap">
      <!-- Tagline + heading + description — always visible -->
      <div class="flex flex-col">
        <p class="text-tagline font-bold uppercase tracking-widest text-muted mb-4">
          Updates
        </p>
        <h1 class="mb-6">
          What's happening now
        </h1>
        <p class="max-w-2xl font-medium">
          The latest developments in Nicaragua's ongoing transition.
        </p>
      </div>

      {featured || gridArticles.length > 0 || categories.length > 0 ? (
        <div class="flex flex-col gap-component-gap">
          <!-- Filters — only when categories exist -->
          <!-- one-off: push filters 8px below heading gap -->
          {categories.length > 0 && (
            <FilterPills
              name="update-category"
              options={categories.map((c) => ({ label: c.name, value: c.slug }))}
              allLabel="All updates"
              ariaLabel="Update category filters"
              class="mt-2"
            />
          )}

          <!-- Listing block: featured + pagination + grid -->
          <div class="flex flex-col gap-component-gap">
            <!-- Featured update card — always visible when data exists -->
            {
              featured ? (
                <div>
                  <FeaturedUpdateCard {...featured} />
                </div>
              ) : (
                <p class="text-small text-muted">No featured update available.</p>
              )
            }

            <!-- Pagination — only when grid articles exist to paginate -->
            {gridArticles.length > 0 && <UpdatePagination />}

            <!-- Update grid — paginated via client-side script -->
            <UpdateGrid articles={gridArticles} />

            <!-- Empty state — shown when filter + pagination yield no grid items -->
            <p data-update-empty hidden class="col-span-full text-center text-muted py-12">
              No updates in this category
            </p>
          </div>
        </div>
      ) : (
        <p class="text-center text-muted py-16">No updates published yet.</p>
      )}

    </div>
  </Container>
</section>

<script>
  (function () {
    var nav = document.querySelector('[data-filter-pills="update-category"]')
    var grid = document.querySelector('[data-update-grid]')
    if (!nav || !grid) return

    // FilterPills handles aria-current toggling and dispatches pill-change
    nav.addEventListener('pill-change', function (e) {
      var category = e.detail.value || ''

      // Show/hide grid items by category (featured is always visible)
      var items = Array.from(grid.querySelectorAll(':scope > li'))
      for (var j = 0; j < items.length; j++) {
        var el = items[j]
        var itemCat = el.getAttribute('data-card-category') || ''
        var hide = category !== '' && itemCat !== category
        el.hidden = hide
      }

      // Dispatch filter-change so pagination recalculates
      grid.dispatchEvent(new CustomEvent('filter-change'))
    })
  })()
</script>
