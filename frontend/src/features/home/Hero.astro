---
/**
 * Hero
 *
 * Self-fetches hero data. No props required.
 *
 * Props: class (string) — spread onto root <section> for consumer overrides
 * Slots: none
 * Tokens: --color-contrast-text
 * Hardcoded literals: inherited from earlier design
 * Context variants: not needed (hero overlay is always dark — invariant)
 * Composed from: Container, CtaRow
 *
 * Design notes (Figma: Header / 88 /):
 *   - Semi-transparent Card (#00000066) with rounded corners sits on image
 *   - Card padding: 64px sides desktop, 32px all mobile
 *   - Content column ~560px wide, LEFT-aligned (not centered)
 */

import Container from '@/layouts/Container.astro'
import CtaRow from '@/components/CtaRow.astro'
import { getHero } from './hero.api'
import { HERO } from '@/lib/content'

interface Props {
  class?: string
}

const { class: className } = Astro.props

const heroData = await getHero().catch((err) => {
  console.error('Failed to fetch hero:', err)
  return null
})

const title = heroData?.title || HERO.fallbackTitle
const subtitle =
  heroData?.subtitle ||
  HERO.fallbackSubtitle
const heroImage = heroData?.heroImage || { url: '', alt: '' }
---

<section
  class:list={[
    'relative flex min-h-0 flex-col lg:h-[calc(100vh-var(--nav-height))] lg:max-h-[790px]',
    className,
  ]}
>
  <Container class="flex flex-1 flex-col">
    {
      /*
        Card wrapper: relative so image + overlay are clipped to its bounds.
        rounded-lg clips the image corners; overflow-hidden enforces the clip.
        Card padding: 32px all sides mobile, 0 top/bottom + 64px sides desktop.
      */
    }
    {
      /*
        Card spacing — Figma:
          Mobile: padding 32px all around
          Desktop: Column inside Card at y=100.5 (auto-layout centering
                   creates ~100px visual spacing top & bottom),
                   plus explicit 64px left/right padding.
          md:py-24 ≈ 96px matches the ~100px visual spacing.
      */
    }
    <div
      class="text-contrast-text relative flex flex-1 flex-col overflow-hidden rounded-lg px-8 py-8 sm:min-h-[420px] md:min-h-[520px] md:px-16 lg:pb-24 lg:pt-20"
    >
      {
        /*
          Background image: fills the card area only (not the full viewport).
          Figma: image is behind the card, visible through the semi-transparent overlay.
        */
      }
      <img
        src={heroImage.url}
        alt={heroImage.alt}
        class="absolute inset-0 h-full w-full object-cover"
        aria-hidden={!heroImage.alt}
      />

      {
        /*
          Overlay — mobile: solid dark (content spans full card width)
          Desktop: left→right gradient, dark over text column, fades subtely
          */
      }
      <div
        class="absolute inset-0 bg-black/50 lg:bg-transparent lg:bg-[linear-gradient(to_right,rgba(0,0,0,0.6),rgba(0,0,0,0.4)_50%,rgba(0,0,0,0.05))]"
      >
      </div>

      {
        /*
          Content column: ~560px wide (35rem), left-aligned, sits above overlay.
          Figma Content frame is 560px with horizontalAlignment: LEFT.
        */
      }
      <div class="relative z-10 max-w-[35rem]">
        <div class="flex flex-col gap-f8">
          <h1>
            {title}
          </h1>

          <p class="opacity-90">
            {subtitle}
          </p>
        </div>

        <div class="mt-f9">
          <CtaRow
            buttons={[
              { label: HERO.learnMore, href: '/about', variant: 'inverse' },
              { label: HERO.donate, href: '/donate', variant: 'inverse-outline' },
            ]}
            size="md"
            gap="sm"
          />
        </div>
      </div>
    </div>
  </Container>
</section>
