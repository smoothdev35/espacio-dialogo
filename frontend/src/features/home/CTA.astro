---
/**
 * CTA
 *
 * Homepage CTA section — thin wrapper around CtaAction.
 * Provides the homepage's fixed heading, body, and Donate + Contact buttons.
 *
 * Props: class? (string) — spread onto CtaAction's root <section>
 * Slots: none
 * Tokens: none consumed directly (delegated to CtaAction)
 * Hardcoded literals: heading/body text, button labels + hrefs — intrinsic to role
 * Context variants: not needed (CtaAction handles bg-surface-alt)
 * Composed from: CtaAction
 */
import CtaAction from '@/components/CtaAction.astro'
import { CTA_HOME } from '@/lib/content'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<CtaAction
  heading={CTA_HOME.heading}
  description={CTA_HOME.description}
  buttons={[
    { label: CTA_HOME.donate, href: '/donate', variant: 'primary' },
    { label: CTA_HOME.contact, href: '#footer', variant: 'secondary' },
  ]}
  size="md"
  class={className}
/>
