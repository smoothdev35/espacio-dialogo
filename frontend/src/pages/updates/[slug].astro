---
/**
 * Update Detail Page
 *
 * Dynamic route: /updates/[slug]
 * Props: none — reads slug from Astro.params
 * Slots: none
 * Tokens: --color-page, --color-page-text, --color-muted, --spacing-section-pad (via global section rule)
 * Hardcoded literals: none
 * Context variants: not needed
 * Composed from: BaseLayout, Container, UpdateHeader
 */

import BaseLayout from '@/layouts/BaseLayout.astro'
import Container from '@/layouts/Container.astro'
import UpdateHeader from '@/features/update/UpdateHeader.astro'
import { fetchUpdateBySlug, fetchUpdateSlugs } from '@/features/update/update.api'

export async function getStaticPaths() {
  const slugs = await fetchUpdateSlugs()
  return slugs.map(({ slug }) => ({
    params: { slug },
  }))
}

const { slug } = Astro.params

if (!slug) {
  return Astro.redirect('/404')
}

const update = await fetchUpdateBySlug(slug)

if (!update) {
  return Astro.redirect('/404')
}

const title = `${update.title} — EDD`
---

<BaseLayout title={title}>
  <section>
    <Container>
      <UpdateHeader update={update} />
    </Container>
  </section>
</BaseLayout>
