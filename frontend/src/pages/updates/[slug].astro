---
/**
 * Update Detail Page
 *
 * Dynamic route: /updates/[slug]
 * Semantic: <article> wraps header (wide container) + body (regular container).
 * Header uses --container-wide (1536px) for the featured image to breathe.
 *
 * Props: none — reads slug from Astro.params
 * Slots: none
 * Tokens: --color-page, --color-page-text, --color-muted,
 *         --spacing-f11, --container-small, --container-wide
 * Hardcoded literals:
  *   - mt-f11 — header→body gap
 *   - max-w-(--container-small) — 768px reading width via token
 * Context variants: not needed
 * Composed from: BaseLayout, Container, UpdateHeader, UpdateBody, TimelineSection
 */

import BaseLayout from '@/layouts/BaseLayout.astro'
import Container from '@/layouts/Container.astro'
import UpdateHeader from '@/features/update/UpdateHeader.astro'
import UpdateBody from '@/features/update/UpdateBody.astro'
import TimelineSection from '@/features/update/TimelineSection.astro'
import { fetchUpdateBySlug, fetchUpdateSlugs } from '@/features/update/update.api'

export async function getStaticPaths() {
  const slugs = await fetchUpdateSlugs()
  return slugs.map(({ slug }) => ({
    params: { slug },
  }))
}

const { slug } = Astro.params

if (!slug) {
  return Astro.redirect('/404')
}

const update = await fetchUpdateBySlug(slug)

if (!update) {
  return Astro.redirect('/404')
}

const title = `${update.title} — EDD`
---

<BaseLayout title={title}>
  <section>
    <Container wide>
    <article>
      <UpdateHeader update={update} />

      <!-- Body: 1.5× section-pad-lg gap from header bottom -->
      <div class="mx-auto mt-f11 max-w-(--container-small)">
        <UpdateBody body={update.body} />
      </div>
    </article>
    </Container>
  </section>

  <TimelineSection currentSlug={update.slug} />
</BaseLayout>
