---
import BaseLayout from '@/layouts/BaseLayout.astro'
import CtaAction from '@/components/CtaAction.astro'
import { NOT_FOUND } from '@/lib/content'
---

<BaseLayout title={NOT_FOUND.title}>
  <CtaAction
    level="h1"
    heading={NOT_FOUND.heading}
    description={NOT_FOUND.body}
    buttons={[
      { label: NOT_FOUND.backHome, href: '/', variant: 'primary' },
      { label: NOT_FOUND.goToBlog, href: '/blog', variant: 'secondary' },
    ]}
    size="lg"
  />
</BaseLayout>
