---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Container from '@/layouts/Container.astro'
import Button from '@/components/ui/astro/Button.astro'
---

<BaseLayout title="Página no encontrada">
  <Container
    class="flex max-h-[790px] min-h-[calc(100vh-var(--nav-height))] flex-col items-center justify-center text-center -mt-4"
  >
    <h2 class="-mt-14 mb-8 max-w-2xl text-balance">
      El camino hacia Nicaragua libre no es una línea recta.
    </h2>
    <p class="mb-8 max-w-md text-balance text-xl">
      El contenido que buscaste no existe en esta página.
    </p>
    <div class="flex items-center gap-10 mt-8">
      <Button label="Volver al inicio" href="/" variant="primary" size="lg" />
      <Button label="Ir al blog" href="/blog" variant="secondary" size="lg" />
    </div>
  </Container>
</BaseLayout>
