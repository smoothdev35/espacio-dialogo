---
/**
 * Blog Post Detail Page
 *
 * Dynamic route: /blog/[slug]
 * Assembles BlogPostHeader, rich text body, ToC sidebar,
 * CTA section, and related posts slider.
 *
 * Semantic: <article> wraps header (wide container) + body (regular container).
 * Header uses --container-wide (1536px) for the featured image to breathe.
 *
 * Props: documentId — Strapi document ID for direct single-type fetch
 *        (avoids slug filter through custom find controller)
 * Slots: none
 * Tokens: --color-page, --color-page-text, --color-muted, --color-surface-alt,
 *         --spacing-f10, --spacing-f11, --container-small, --container-wide
 * Hardcoded literals:
 *   - Article column max-w-(--container-small) (768px) — matches Figma body width
 *   - ToC sidebar w-80 (320px) — component-specific layout, no token equivalent
 *   - Related posts section py-f10 — standard section padding
 *   - CTA section py-f11 — standard large section padding
  *   - mt-f11 — header→body gap
 * Context variants: not needed
 * Composed from: BaseLayout, Container, BlogPostHeader, BlogPostSlider,
 *                BlocksRenderer, TableOfContents, CtaAction
 */

import BaseLayout from '@/layouts/BaseLayout.astro'
import Container from '@/layouts/Container.astro'
import BlogPostHeader from '@/features/blogpost/BlogPostHeader.astro'
import BlogPostSlider from '@/features/blogpost/BlogPostSlider.astro'
import BlocksRenderer from '@/components/BlocksRenderer.astro'
import TableOfContents from '@/components/TableOfContents.astro'
import CtaAction from '@/components/CtaAction.astro'

import {
  fetchBlogPostByDocumentId,
  fetchBlogPostSlugs,
  fetchBlogPostAction,
  fetchRelatedBlogPosts,
} from '@/features/blogpost/blogpost.api'
import { extractHeadings } from '@/lib/blocks-renderer'
import { BLOG_RELATED } from '@/lib/content'
import { buildSrcSet } from '@/lib/media'

export interface Props {
  documentId: string
}

export async function getStaticPaths() {
  const slugs = await fetchBlogPostSlugs()
  return slugs.map(({ slug, documentId }) => ({
    params: { slug },
    props: { documentId },
  }))
}

const { slug } = Astro.params
const { documentId } = Astro.props

if (!slug || !documentId) {
  return Astro.redirect('/404')
}

const post = await fetchBlogPostByDocumentId(documentId)

if (!post) {
  return Astro.redirect('/404')
}

// Fetch data for page sections
const headings = extractHeadings(post.body)
const blogPostAction = await fetchBlogPostAction()
const relatedPosts = await fetchRelatedBlogPosts(post.slug, post.tags)

const title = `${post.title} — EDD`
const canonicalUrl = `${import.meta.env.SITE_URL ?? ''}/blog/${post.slug}`
const pageDescription = post.excerpt
const ogImage = post.featuredImage?.url ?? ''
const ogImageAlt = post.featuredImage?.alternativeText ?? ''
const featuredImage = post.featuredImage
const featuredSrcSet = featuredImage ? buildSrcSet(featuredImage) : ''
---

<BaseLayout title={title}>
  <!-- head slot: SEO meta, canonical, OG tags -->
  {
    featuredImage && (
      <link
        slot="head"
        rel="preload"
        as="image"
        href={featuredImage.url}
        imagesrcset={featuredSrcSet}
        imagesizes="(max-width: 1536px) 100vw, 1536px"
        fetchpriority="high"
      />
    )
  }
  <link slot="head" rel="canonical" href={canonicalUrl} />
  <meta slot="head" name="description" content={pageDescription} />
  <meta slot="head" property="og:title" content={title} />
  <meta slot="head" property="og:description" content={pageDescription} />
  <meta slot="head" property="og:url" content={canonicalUrl} />
  <meta slot="head" property="og:type" content="article" />
  {
    ogImage && (
      <>
        <meta slot="head" property="og:image" content={ogImage} />
        <meta slot="head" property="og:image:alt" content={ogImageAlt} />
      </>
    )
  }
  <meta slot="head" name="robots" content="index, follow" />
  <meta slot="head" name="twitter:card" content="summary_large_image" />
  <meta slot="head" name="twitter:title" content={title} />
  <meta slot="head" name="twitter:description" content={pageDescription} />
  {ogImage && <meta slot="head" name="twitter:image" content={ogImage} />}

  <!-- JSON-LD structured data -->
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: post.title,
      description: post.excerpt,
      datePublished: post.dateIso,
      author: post.author
        ? {
            '@type': 'Person',
            name: post.author.name,
            url: post.author.slug
              ? `${import.meta.env.SITE_URL ?? ''}/author/${post.author.slug}`
              : undefined,
          }
        : undefined,
      image: ogImage || undefined,
      url: canonicalUrl,
    })}
  />

  <section>
    <Container wide>
    <article>
      <BlogPostHeader post={post} />

      <!-- Body + ToC sidebar -->
      <div class="mt-f11 flex flex-col lg:flex-row lg:justify-between">
        <div class="w-full max-w-(--container-small)">
          <BlocksRenderer
            blocks={post.body}
            class="[&>blockquote]:my-9 [&>h2:not(:first-child)]:mt-6 [&>h2]:mb-5 [&>h3:not(:first-child)]:mt-6 [&>h3]:mb-5 [&>h4:not(:first-child)]:mt-6 [&>h4]:mb-5 [&>h5:not(:first-child)]:mt-5 [&>h5]:mb-4 [&>h6:not(:first-child)]:mt-5 [&>h6]:mb-4 [&>img]:my-12 [&>ol]:mb-4 [&>p]:mb-4 [&>pre]:my-9 [&>ul]:mb-4"
          />
        </div>

        {
          headings.length > 0 && (
            <aside class="hidden w-80 shrink-0 xl:block sticky top-[calc(var(--nav-height)+2rem)] self-start">
              <TableOfContents headings={headings} />
            </aside>
          )
        }
      </div>
    </article>
    </Container>
  </section>

  <!-- CTA section (bg-surface-alt) -->
  {
    blogPostAction && (
      <CtaAction
        heading={blogPostAction.heading}
        description={blogPostAction.description}
        buttons={[
          {
            label: blogPostAction.buttonLabel,
            href: blogPostAction.buttonUrl,
            variant: 'primary',
          },
        ]}
        size="lg"
      />
    )
  }

  <!-- Related posts slider -->
  {
    relatedPosts.length > 0 && (
      <BlogPostSlider posts={relatedPosts} heading={BLOG_RELATED.heading} showViewAll={false} />
    )
  }
</BaseLayout>
