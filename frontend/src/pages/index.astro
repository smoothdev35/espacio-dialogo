---
import BaseLayout from '@/layouts/BaseLayout.astro'
import HomeLayout from '@/features/home/HomeLayout.astro'
import { getHero } from '@/features/home/hero.api'
import { buildSrcSet } from '@/lib/media'

export interface Props {
  title?: string
}

const { title = 'Home — EDD' } = Astro.props

const hero = await getHero().catch(() => null)
const heroImage = hero?.heroImage
const heroSrcSet = heroImage ? buildSrcSet(heroImage) : ''
---

<BaseLayout title={title}>
  {
    heroImage && (
      <link
        slot="head"
        rel="preload"
        as="image"
        href={heroImage.url}
        imagesrcset={heroSrcSet}
        imagesizes="100vw"
        fetchpriority="high"
      />
    )
  }
  <HomeLayout />
</BaseLayout>
