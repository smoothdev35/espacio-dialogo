---
import BaseLayout from '@/layouts/BaseLayout.astro'
import HomeLayout from '@/features/home/HomeLayout.astro'
import { getHero } from '@/features/home/hero.api'

export interface Props {
  title?: string
}

const { title = 'Home — EDD' } = Astro.props

const hero = await getHero().catch(() => null)
const heroImageUrl = hero?.heroImage?.url
---

<BaseLayout title={title}>
  {
    heroImageUrl && (
      <link
        slot="head"
        rel="preload"
        as="image"
        href={heroImageUrl}
        fetchpriority="high"
      />
    )
  }
  <HomeLayout />
</BaseLayout>
