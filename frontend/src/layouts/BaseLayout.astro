---
/**
 * BaseLayout
 *
 * Props: title (string) — page title, default 'EDD'
 *        class? (string) — spread onto <body> for consumer overrides
 *        navLinks? — custom nav link array (defaults to site links)
 *        navActions? — custom nav action array (defaults to site CTAs)
 * Slots: default — page content inside <main>
 *        head — page-specific <head> injections (canonical, meta, etc.)
 * Tokens: --color-page, --color-page-text, --color-nav-bg, etc.
 * Hardcoded literals: theme detection script, html structure
 * Context variants: not needed
 * Composed from: Nav
 */

import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'

interface NavLink {
  label: string
  href: string
  active?: boolean
}

interface NavAction {
  label: string
  href: string
  variant: 'primary' | 'secondary'
}

interface Props {
  title?: string
  class?: string
  navLinks?: NavLink[]
  navActions?: NavAction[]
}

const {
  title = 'EDD',
  class: className,
  navLinks = [
    { label: 'Home', href: '/' },
    { label: 'Blog', href: '/blog' },
    { label: 'Contact', href: '/contact' },
  ],
  navActions = [
    { label: 'Subscribe', href: '#', variant: 'secondary' },
    { label: 'Donate', href: '#', variant: 'primary' },
  ],
} = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <slot name="head" />
    <script is:inline>
      ;(function () {
        var t = localStorage.getItem('theme')
        if (
          t === 'dark' ||
          (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark')
        } else {
          document.documentElement.classList.remove('dark')
        }
      })()
    </script>
  </head>
  <!-- bg + text removed: global body selector sets --color-page and --color-page-text -->
  <body class:list={['flex min-h-screen flex-col', className]}>
    <header>
      <Nav links={navLinks} actions={navActions} />
    </header>

    <main class="flex flex-1 flex-col">
      <slot />
    </main>

    <Footer />
  </body>
</html>
