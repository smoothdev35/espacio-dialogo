---
/**
 * BaseLayout
 *
 * Props: title (string) — page title, default 'EDD'
 *        class? (string) — spread onto <body> for consumer overrides
 *        navLinks? — custom nav link array (defaults to site links)
 *        navActions? — custom nav action array (defaults to site CTAs)
 * Slots: default — page content inside <main>
 *        head — page-specific <head> injections (canonical, meta, etc.)
 * Tokens: --color-page, --color-page-text, --color-nav-bg, etc.
 * Hardcoded literals: theme detection script, html structure
 * Context variants: not needed
 * Composed from: Nav
 */

import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import { NAV } from '../lib/content'

interface NavLink {
  label: string
  href: string
  active?: boolean
}

interface NavAction {
  label: string
  href: string
  variant: 'primary' | 'secondary'
}

interface Props {
  title?: string
  description?: string
  class?: string
  navLinks?: NavLink[]
  navActions?: NavAction[]
}

const {
  title = 'EDD',
  description = 'Espacio Diálogo — colectivo que documenta, apoya y amplifica las voces que trabajan por una Nicaragua libre y democrática.',
  class: className,
  navLinks = [
    { label: NAV.home, href: '/' },
    { label: NAV.blog, href: '/blog' },
    { label: NAV.contact, href: '#footer' },
  ],
  navActions = [
    { label: NAV.subscribe, href: '/subscribe', variant: 'secondary' },
    { label: NAV.donate, href: '/donate', variant: 'primary' },
  ],
  } = Astro.props

const strapiOrigin = import.meta.env.PUBLIC_STRAPI_URL
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {
      strapiOrigin && <link rel="preconnect" href={strapiOrigin} />
    }
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Lora:wght@700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <title>{title}</title>
    <slot name="head" />
    <script is:inline>
      ;(function () {
        var t = localStorage.getItem('theme')
        if (
          t === 'dark' ||
          (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark')
        } else {
          document.documentElement.classList.remove('dark')
        }
      })()
    </script>
  </head>
  <!-- bg + text removed: global body selector sets --color-page and --color-page-text -->
  <body class:list={['flex min-h-screen flex-col', className]}>
    <header>
      <Nav links={navLinks} actions={navActions} />
    </header>

    <main class="flex flex-1 flex-col">
      <slot />
    </main>

    <Footer />
  </body>
</html>
