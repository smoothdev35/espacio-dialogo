---
/**
 * TableOfContents
 *
 * Sticky sidebar table of contents with scroll-spy active state.
 * Renders h2/h3 headings as a nested list. Falls back to static
 * anchor links when JavaScript is unavailable or disabled.
 *
 * Props:
 *   headings: TocEntry[] — { level: 2 | 3, text: string, id: string }[]
 *   class?: string — spread onto root <nav>
 * Slots: none
 * Tokens: --color-page-text, --color-muted, --color-link-text, --color-link-hover,
 *         --color-border-focus, --spacing-section-pad
 * Hardcoded literals:
 *   - pl-4 (h3 indent) — component-specific layout, no token equivalent
 *   - top-(--spacing-section-pad) (sticky offset) — needs token confirmation
 *   - 2px / 0 offset for border-left on active item — styling choice, no token equivalent
 * Context variants: not needed
 * Composed from: none
 */

import type { TocEntry } from '@/lib/blocks-renderer'

interface Props {
  headings: TocEntry[]
  label?: string
  class?: string
}

const { headings, label = 'Table of contents', class: className } = Astro.props

/** Organise headings into h2 → nested h3 structure */
function buildNestedList(items: TocEntry[]): { h2: TocEntry; h3s: TocEntry[] }[] {
  const result: { h2: TocEntry; h3s: TocEntry[] }[] = []
  let currentH3s: TocEntry[] = []

  for (const item of items) {
    if (item.level === 2) {
      if (result.length > 0) {
        result[result.length - 1].h3s = currentH3s
      }
      result.push({ h2: item, h3s: [] })
      currentH3s = []
    } else if (item.level === 3 && result.length > 0) {
      currentH3s.push(item)
    }
  }
  if (result.length > 0) {
    result[result.length - 1].h3s = currentH3s
  }

  return result
}

const nested = buildNestedList(headings)
const hasItems = nested.length > 0
---

{
  hasItems && (
    <nav
      class:list={[
        "toc-nav hidden lg:block sticky top-(--spacing-section-pad) max-h-[calc(100vh-var(--spacing-section-pad)*2)] overflow-y-auto",
        className,
      ]}
      aria-label={label}
    >
      <p class="text-sm font-semibold text-page-text mb-3 uppercase tracking-wider">{label}</p>
      <ul class="space-y-1 text-sm">
        {
          nested.map(({ h2, h3s }) => (
            <li>
              <a
                href={`#${h2.id}`}
                class="toc-link block py-1 text-muted hover:text-page-text transition-colors border-l-2 border-transparent hover:border-current pl-0"
                data-toc-level={h2.level}
              >
                {h2.text}
              </a>
              {h3s.length > 0 && (
                <ul class="pl-4 space-y-1 mt-1">
                  {h3s.map((h3) => (
                    <li>
                      <a
                        href={`#${h3.id}`}
                        class="toc-link block py-0.5 text-muted hover:text-page-text transition-colors border-l-2 border-transparent hover:border-current"
                        data-toc-level={h3.level}
                      >
                        {h3.text}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  )
}

<script>
  /**
   * Scroll-spy: marks the topmost visible heading as active.
   * Degrades gracefully — if IntersectionObserver is unsupported,
   * static anchor links still function.
   */
  class ToCScrollSpy {
    private nav: HTMLElement | null
    private links: NodeListOf<HTMLAnchorElement>
    private headings: HTMLElement[]
    private observer: IntersectionObserver | null = null
    private activeId: string | null = null

    constructor() {
      this.nav = document.querySelector('.toc-nav')
      if (!this.nav) return

      this.links = this.nav.querySelectorAll<HTMLAnchorElement>('.toc-link')
      if (this.links.length === 0) return

      // Collect all heading elements referenced by ToC
      this.headings = Array.from(this.links)
        .map((link) => {
          const id = link.getAttribute('href')?.replace('#', '')
          return id ? document.getElementById(id) : null
        })
        .filter((el): el is HTMLElement => el !== null)

      if (this.headings.length === 0) return

      this.setupObserver()
      this.setupClickHandlers()
    }

    private setupObserver(): void {
      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches

      this.observer = new IntersectionObserver(
        (entries) => {
          // Find the topmost visible heading
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)

          if (visible.length > 0) {
            const top = visible[0].target.id
            if (top !== this.activeId) {
              this.setActive(top)
            }
          }
        },
        {
          rootMargin: prefersReducedMotion ? '0px' : '-80px 0px -60% 0px',
          threshold: 0,
        },
      )

      this.headings.forEach((h) => this.observer?.observe(h))
    }

    private setupClickHandlers(): void {
      this.links.forEach((link) => {
        link.addEventListener('click', (e) => {
          const href = link.getAttribute('href')
          if (!href) return

          const id = href.replace('#', '')
          const target = document.getElementById(id)
          if (!target) return

          // Update URL hash without causing a jump
          history.replaceState(null, '', href)

          // If JS is available, use smooth scroll
          const prefersReducedMotion = window.matchMedia(
            '(prefers-reduced-motion: reduce)',
          ).matches

          e.preventDefault()

          target.scrollIntoView({
            behavior: prefersReducedMotion ? 'auto' : 'smooth',
            block: 'start',
          })

          // Set active immediately on click
          this.setActive(id)
        })
      })
    }

    private setActive(id: string): void {
      this.activeId = id

      this.links.forEach((link) => {
        const linkId = link.getAttribute('href')?.replace('#', '')
        const isActive = linkId === id

        link.setAttribute('aria-current', isActive ? 'true' : 'false')

        // Toggle visual active state
        if (isActive) {
          link.classList.add('!bg-filter-bg', '!text-filter-fg')
        } else {
          link.classList.remove('!bg-filter-bg', '!text-filter-fg')
        }
      })
    }

    public destroy(): void {
      this.observer?.disconnect()
    }
  }

  // Initialise after DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new ToCScrollSpy())
  } else {
    new ToCScrollSpy()
  }
</script>
