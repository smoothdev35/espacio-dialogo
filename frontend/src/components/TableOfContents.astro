---
/**
 * TableOfContents
 *
 * Sticky sidebar table of contents with box-edge "stairs" design.
 * Each successive button's left edge shifts right by 1rem via
 * margin-left, with width compensated so the right edge always
 * reaches the parent's (aside's) right edge — active band
 * (filter-bg) stays flush on the right. Padding is constant
 * 1rem horizontally for text breathing room inside each pill.
 *
 * Driven by CSS custom property --toc-depth (array index) fed
 * inline per item via the `style` prop:
 *   item 0 → margin-left 0, width 100%
 *   item 1 → margin-left 1rem, width calc(100% - 1rem)
 *   item 2 → margin-left 2rem, width calc(100% - 2rem)
 *   …
 *
 * Scales to any number of ToC items with zero CSS changes.
 *
 * Props:
 *   headings: TocEntry[] — { level: 2 | 3, text: string, id: string }[]
 *   class?: string — spread onto root <nav>
 * Slots: none
 * Tokens: --color-filter-bg, --color-filter-fg,
 *         --color-page-text, --color-muted
 * Hardcoded literals:
 *   - gap-3 (vertical gap between items)
 *   - text-sm (label heading)
 *   - --toc-step: 1rem (stairs step)
 *   - padding-left/padding-right: 1rem (constant)
 * Context variants: not needed
 * Composed from: Button (filter variant)
 */

import type { TocEntry } from '@/lib/blocks-renderer'
import Button from '@components/ui/astro/Button.astro'

interface Props {
  headings: TocEntry[]
  label?: string
  class?: string
}

const { headings, label = 'Table of contents', class: className } = Astro.props
const hasItems = headings.length > 0
---

{
  hasItems && (
    <nav class:list={['toc-nav', className]} aria-label={label}>
      <p class="mb-4 text-sm font-semibold uppercase tracking-wider">{label}</p>
      <ol class="flex flex-col gap-3">
        {headings.map((heading, i) => (
          <li>
            <Button
              variant="filter"
              size="md"
              href={`#${heading.id}`}
              label={heading.text}
              class:list={['toc-link']}
              style={`--toc-depth: ${i}`}
              data-toc-level={heading.level}
            />
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style is:global>
  /**
   * ToC stair indentation — overrides Button's inline-flex justify-center
   * and px-btn-x-md uniform padding. Global so it reaches through Button's
   * component boundary (Astro scoped styles can't target child component DOM).
   *
   * Box-edge stairs: each successive item gets a larger margin-left,
   * compensated by a narrower width so the right edge always reaches the
   * parent's right edge. Padding stays constant (1rem) for text breathing
   * room inside the pill. Driven by --toc-depth (array index) set inline.
   */
  .toc-link {
    --toc-step: 1rem;
    --toc-indent: calc(var(--toc-depth, 0) * var(--toc-step));
    justify-content: flex-start !important;
    margin-left: var(--toc-indent);
    width: calc(100% - var(--toc-indent));
    padding-left: 1rem !important;
    padding-right: 1rem !important;
  }
</style>

<script>
  /**
   * Scroll-spy: marks the topmost visible heading as active.
   * Degrades gracefully — if IntersectionObserver is unsupported,
   * static anchor links still function.
   */
  function prefersReducedMotion(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches
  }

  class ToCScrollSpy {
    private nav: HTMLElement | null = null
    private links: NodeListOf<HTMLAnchorElement> =
      document.querySelectorAll('.toc-link')
    private headings: HTMLElement[] = []
    private observer: IntersectionObserver | null = null
    private activeId: string | null = null
    private topOffset = 105
    private bottomOffset = 0
    private rafId = 0

    constructor() {
      this.nav = document.querySelector('.toc-nav')
      if (!this.nav) return

      this.links = this.nav.querySelectorAll<HTMLAnchorElement>('.toc-link')
      if (this.links.length === 0) return

      // Collect all heading elements referenced by ToC
      this.headings = Array.from(this.links)
        .map((link) => {
          const id = link.getAttribute('href')?.replace('#', '')
          return id ? document.getElementById(id) : null
        })
        .filter((el): el is HTMLElement => el !== null)

      if (this.headings.length === 0) return

      if (!prefersReducedMotion()) {
        this.bottomOffset = window.innerHeight * 0.4
      } else {
        this.topOffset = 0
      }

      this.setupObserver()
      this.setupClickHandlers()
      window.addEventListener('scroll', this.onScroll, { passive: true })
    }

    private onScroll = (): void => {
      if (!this.rafId) {
        this.rafId = requestAnimationFrame(this.scrollFrame)
      }
    }

    private scrollFrame = (): void => {
      this.rafId = 0
      this.syncActive()
    }

    private setupObserver(): void {
      this.observer = new IntersectionObserver(() => this.syncActive(), {
        rootMargin: prefersReducedMotion() ? '0px' : '-105px 0px -60% 0px',
        threshold: 0,
      })

      this.headings.forEach((h) => this.observer?.observe(h))
    }

    private syncActive(): void {
      // Classic scroll-spy: the active heading is the last one that has
      // scrolled past the sticky-header offset, or — before any heading
      // reaches it — the topmost heading visible in the band. The clicked
      // target settles at viewport top (above the band), so activating only
      // "visible" headings broke click-sync; position logic fixes it.
      // Driven by a throttled scroll listener (authoritative, fires on the
      // final settle frame) plus the IntersectionObserver as a fallback for
      // non-scroll layout shifts.
      let activeId = ''
      let topmostVisible = ''

      for (const heading of this.headings) {
        const top = heading.getBoundingClientRect().top
        if (top <= this.topOffset) {
          activeId = heading.id
        } else if (top < this.bottomOffset && !topmostVisible) {
          topmostVisible = heading.id
        }
      }

      const candidate = activeId || topmostVisible || this.headings[0].id
      if (candidate !== this.activeId) {
        this.setActive(candidate)
      }
    }

    private setupClickHandlers(): void {
      this.links.forEach((link) => {
        link.addEventListener('click', (e) => {
          const href = link.getAttribute('href')
          if (!href) return

          const id = href.replace('#', '')
          const target = document.getElementById(id)
          if (!target) return

          // Update URL hash without causing a jump
          history.replaceState(null, '', href)

          // If JS is available, use smooth scroll
          const reduceMotion = prefersReducedMotion()

          e.preventDefault()

          target.scrollIntoView({
            behavior: reduceMotion ? 'auto' : 'smooth',
            block: 'start',
          })

          // Set active immediately on click
          this.setActive(id)
        })
      })
    }

    private setActive(id: string): void {
      this.activeId = id

      this.links.forEach((link) => {
        const linkId = link.getAttribute('href')?.replace('#', '')
        const isActive = linkId === id

        link.setAttribute('aria-current', isActive ? 'true' : 'false')

        // Toggle visual active state
        if (isActive) {
          link.classList.add('!bg-filter-bg', '!text-filter-fg')
        } else {
          link.classList.remove('!bg-filter-bg', '!text-filter-fg')
        }
      })
    }

    public destroy(): void {
      this.observer?.disconnect()
      window.removeEventListener('scroll', this.onScroll)
      if (this.rafId) cancelAnimationFrame(this.rafId)
    }
  }

  // Initialise after DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new ToCScrollSpy())
  } else {
    new ToCScrollSpy()
  }
</script>
