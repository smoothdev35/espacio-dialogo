---
interface Props {
  legend: string
  name: string
  options: Array<{
    value: string
    label: string
    disabled?: boolean
    checked?: boolean
  }>
  errorMessage?: string
  class?: string
}

const {
  legend,
  name,
  options,
  errorMessage,
  class: className = '',
  ...rest
} = Astro.props

const hasError = !!errorMessage
const groupId = `radio-group-${name}`
const errorId = `${groupId}-error`
---

<fieldset class:list={['flex flex-col gap-2', className]} {...rest}>
  <legend class="text-sm">{legend}</legend>
  {
    options.map((opt) => {
      const optId = `${groupId}-${opt.value}`
      return (
        <label for={optId} class="flex cursor-pointer items-center gap-2">
          <input
            type="radio"
            id={optId}
            name={name}
            value={opt.value}
            checked={opt.checked}
            disabled={opt.disabled}
            aria-invalid={hasError ? 'true' : undefined}
            aria-describedby={hasError ? errorId : undefined}
            class="peer sr-only"
          />
          <span
            class="border-radio-border bg-radio-bg peer-checked:border-radio-bg-checked peer-checked:bg-radio-bg-checked flex h-4 w-4 shrink-0 items-center justify-center rounded-full border peer-disabled:opacity-50"
            aria-hidden="true"
          >
            <span class="bg-radio-dot h-2 w-2 rounded-full opacity-0 transition-opacity peer-checked:opacity-100" />
          </span>
          <span>{opt.label}</span>
        </label>
      )
    })
  }
  {
    hasError && (
      <p id={errorId} class="text-error text-sm" role="alert">
        {errorMessage}
      </p>
    )
  }
</fieldset>
