---
interface Props {
  label: string
  variant?: 'primary' | 'secondary' | 'inverse' | 'inverse-outline' | 'nav' | 'filter'
  size?: 'sm' | 'md' | 'lg'
  href?: string
  disabled?: boolean
  type?: 'button' | 'submit' | 'reset'
  icon?: string
  iconPosition?: 'leading' | 'trailing' | 'only'
  id?: string
  class?: string
  style?: string
}

const {
  label,
  variant = 'primary',
  size = 'md',
  href,
  disabled = false,
  type = 'button',
  icon,
  iconPosition,
  class: className = '',
  ...rest
} = Astro.props

const isLink = !!href
const Tag = isLink ? 'a' : 'button'

const baseClasses =
  'inline-flex items-center justify-center gap-2 rounded-md transition-all disabled:cursor-not-allowed translate-y-0 active:translate-y-1 pointer-coarse:active:duration-0'

const variantClasses: Record<string, string> = {
  primary: 'bg-btn-primary text-btn-primary-text border border-btn-primary-border shadow-btn-primary hover:bg-btn-primary-hover hover:text-btn-primary-text focus-visible:text-btn-primary-text active:shadow-btn-primary-active disabled:bg-btn-primary-disabled disabled:text-btn-primary-disabled-text disabled:shadow-none duration-150',
  secondary: `bg-btn-secondary text-page-text border border-btn-secondary-border shadow-btn-secondary hover:bg-btn-secondary-hover hover:text-page-text focus-visible:text-page-text active:shadow-btn-secondary-active disabled:bg-btn-secondary-disabled disabled:text-btn-secondary-disabled-text disabled:shadow-none duration-150`,
  /**
   * 'inverse' variants hardcode light-mode colors so they don't swap on .dark toggle.
   * Intended for buttons rendered on an always-dark surface (e.g., hero image overlay)
   * where theme-based inversion would produce wrong contrast.
   */
  inverse:
    'bg-contrast-text text-[#020306] border border-[#b3b3b4] shadow-btn-inverse hover:bg-btn-inverse-hover hover:text-[#020306] focus-visible:text-[#020306] active:shadow-btn-inverse-active disabled:bg-[#d9d9d9] disabled:text-[#b3b3b4] disabled:shadow-none duration-150',
  'inverse-outline':
    'bg-white/10 backdrop-blur-[3px] text-contrast-text border border-white/20 shadow-btn-inverse-outline hover:bg-btn-inverse-outline-hover hover:text-contrast-text focus-visible:text-contrast-text active:shadow-btn-inverse-outline-active disabled:opacity-50 disabled:shadow-none duration-150',
  /**
   * 'nav' variant — icon-only navigation arrows.
   * Fixed square dimensions per size. Uses nav-specific tokens for bg/icon/hover.
   * Always paired with iconPosition="only".
   */
  nav: 'bg-nav-bg text-nav-btn-fg hover:bg-nav-arrow-hover focus-visible:bg-nav-arrow-hover disabled:opacity-30 disabled:!cursor-default disabled:pointer-events-none active:!translate-y-0',
  filter: 'bg-transparent text-muted hover:bg-filter-bg hover:text-filter-fg focus-visible:bg-filter-bg focus-visible:text-filter-fg',
}

const iconSizes: Record<string, string> = {
  sm: 'h-10 w-10',
  md: 'h-12 w-12',
  lg: 'h-14 w-14',
}

const sizeClasses: Record<string, string> = {
  sm:
    iconPosition === 'only'
      ? variant === 'nav'
        ? iconSizes.sm
        : 'p-btn-icon-sm'
      : 'px-btn-x-sm py-btn-y-sm text-small',
  md:
    iconPosition === 'only'
      ? variant === 'nav'
        ? iconSizes.md
        : 'p-btn-icon-md'
      : 'px-btn-x-md py-btn-y-md',
  lg:
    iconPosition === 'only'
      ? variant === 'nav'
        ? iconSizes.lg
        : 'p-btn-icon-lg'
      : 'px-btn-x-lg py-btn-y-lg text-large',
}

const linkProps = isLink ? { href, role: undefined } : {}
const buttonProps = !isLink ? { type, disabled } : {}
---

<Tag
  class:list={[
    baseClasses,
    variantClasses[variant],
    sizeClasses[size],
    className,
  ]}
  aria-label={iconPosition === 'only' ? label : undefined}
  {...linkProps}
  {...buttonProps}
  {...rest}
>
  {iconPosition === 'only' && <span class="sr-only">{label}</span>}
  {icon && (iconPosition === 'leading' || iconPosition === 'only') && <Fragment set:html={icon} />}
  {iconPosition !== 'only' && <span>{label}</span>}
  {icon && iconPosition === 'trailing' && <Fragment set:html={icon} />}
</Tag>
