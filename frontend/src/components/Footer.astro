---
/**
 * Footer
 *
 * Props: class? (string) — spread onto root <footer> for consumer overrides
 * Slots: none
 * Tokens: --spacing-page-gutters, --font-body, --text-sm, --text-xs
 * Hardcoded literals: nav labels, social icons, legal link, copyright year
 * Context variants: transparent (inherits body background)
 * Composed from: LogoLink, FooterContact, IconFacebook, IconInstagram, IconX, IconLinkedIn, IconYoutube
 */

import LogoLink from './LogoLink.astro'
import FooterContact from '../features/footer/FooterContact.tsx'
import IconFacebook from './icons/IconFacebook.astro'
import IconInstagram from './icons/IconInstagram.astro'
import IconX from './icons/IconX.astro'
import IconLinkedIn from './icons/IconLinkedIn.astro'
import IconYoutube from './icons/IconYoutube.astro'
import { FOOTER } from '../lib/content'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<footer id="footer" class:list={['font-body antialiased border-t border-border', className]}>
  <div class="px-(--spacing-page-gutters) py-12 lg:py-16">
    <!-- Main content grid -->
    <div class="flex flex-col gap-8 sm:grid sm:grid-cols-2">
      <!-- Left column: Logo + Location + Contact + Social -->
      <div class="flex flex-col gap-f4">
        <!-- Logo -->
        <LogoLink />

        <FooterContact client:load />

        <!-- Social icons -->
        <div
          class="mt-10 flex gap-4"
          role="list"
          aria-label={FOOTER.socialAriaLabel}
        >
          <a
            href="https://facebook.com"
            target="_blank"
            rel="noopener noreferrer"
            role="listitem"
            class="flex h-6 w-6 items-center justify-center"
            aria-label="Facebook"
          >
            <IconFacebook class="w-5 h-5" />
          </a>
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            role="listitem"
            class="flex h-6 w-6 items-center justify-center"
            aria-label="Instagram"
          >
            <IconInstagram class="w-5 h-5" />
          </a>
          <a
            href="https://x.com"
            target="_blank"
            rel="noopener noreferrer"
            role="listitem"
            class="flex h-6 w-6 items-center justify-center"
            aria-label="X"
          >
            <IconX class="w-5 h-5" />
          </a>
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            role="listitem"
            class="flex h-6 w-6 items-center justify-center"
            aria-label="LinkedIn"
          >
            <IconLinkedIn class="w-5 h-5" />
          </a>
          <a
            href="https://youtube.com"
            target="_blank"
            rel="noopener noreferrer"
            role="listitem"
            class="flex h-6 w-6 items-center justify-center"
            aria-label="YouTube"
          >
            <IconYoutube class="w-5 h-5" />
          </a>
        </div>
      </div>

      <!-- Right columns: Two link lists -->
      <div class="flex flex-col gap-8 sm:gap-16 md:gap-50 sm:flex-row sm:shrink-0">
        <nav aria-label={FOOTER.aboutNavLabel}>
          <ul class="flex flex-col gap-3">
            <li>
              <a href="#">{FOOTER.ourMission}</a>
            </li>
            <li>
              <a href="/blog">{FOOTER.blog}</a>
            </li>
            <li>
              <a href="/donate">{FOOTER.donate}</a>
            </li>
            <li>
              <a href="#">{FOOTER.statements}</a>
            </li>
          </ul>
        </nav>

        <nav aria-label={FOOTER.contentNavLabel}>
          <ul class="flex flex-col gap-3">
            <li>
              <a href="#updates">{FOOTER.updates}</a>
            </li>
            <li>
              <a href="#">{FOOTER.analysis}</a>
            </li>
            <li>
              <a href="#">{FOOTER.news}</a>
            </li>
          </ul>
        </nav>
      </div>
    </div>

    <!-- Bottom credits -->
    <div
      class="mt-row-gap flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <a href="/legal" class="text-sm underline underline-offset-2"
        >{FOOTER.legalNotice}</a
      >
      <small id="copyright-year" class="font-body text-sm"
        >{FOOTER.copyright(2025)}</small
      >
    </div>
  </div>
</footer>

<script is:inline>
  document.getElementById('copyright-year').textContent =
    `© ${new Date().getFullYear()} Espacio Diálogo. Todos los derechos reservados.`
</script>
