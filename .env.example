# Docker Compose: PostgreSQL container env vars
# Backend Strapi config reads DATABASE_* vars from backend/.env instead.
# These vars are compose-only — they set up the Postgres container + healthcheck.
DB_HOST=espacio-dialogo-postgres
DB_PORT=5432
DB_USER=strapi_admin
DB_PASSWORD=strapi_secure_password
DB_NAME=espacio-dialogo_backend
